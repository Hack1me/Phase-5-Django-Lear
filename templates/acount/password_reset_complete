{% load static tailwind_tags %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouveau mot de passe</title>
    {% tailwind_css %}
</head>
<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-slate-900 to-blue-900 p-4">

<div class="w-full max-w-md bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl p-8 shadow-2xl">

    <h1 class="text-3xl font-bold text-white text-center mb-8">
        Nouveau mot de passe
    </h1>

    {% if validlink %}

        <form method="POST" class="space-y-5">
            {% csrf_token %}

            <div>
                <label class="block text-sm text-slate-200 mb-2">
                    Nouveau mot de passe
                </label>
                <input type="password"
                       name="new_password1"
                       required
                       class="w-full px-4 py-3 rounded-xl bg-white/10 border border-slate-400/30 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-sm text-slate-200 mb-2">
                    Confirmer le mot de passe
                </label>
                <input type="password"
                       name="new_password2"
                       required
                       class="w-full px-4 py-3 rounded-xl bg-white/10 border border-slate-400/30 text-white focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <button type="submit"
                    class="w-full py-3 bg-blue-600 hover:bg-blue-700 rounded-xl font-semibold text-white transition">
                Réinitialiser
            </button>
        </form>

    {% else %}

        <p class="text-center text-red-300">
            Ce lien de réinitialisation est invalide ou a expiré.
        </p>

    {% endif %}

</div>

</body>
</html>